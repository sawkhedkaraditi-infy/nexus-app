# Copy this file to .env and fill it in. Never commit .env.

# MySQL connection string.
# Local (docker compose up -d):  mysql://root:password@localhost:3306/nexus
# Hosted (TiDB Cloud, Aiven, Railway, ...): use the connection string the provider gives you for Prisma.
DATABASE_URL="mysql://root:password@localhost:3306/nexus"

# Secret used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
